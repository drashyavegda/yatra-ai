# Optional: enables real AI itinerary generation through the serverless function in api/generate-trip.js.
# Leave unset to run the app in demo mode (deterministic generator, no paid services).
# NEVER prefix these with VITE_ (that would expose them to the browser).
AI_API_KEY=
# Any OpenAI-compatible chat-completions endpoint. Defaults to OpenAI if unset.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
